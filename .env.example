SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Maps API (for POI/Places of Interest service)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
POI_RESULTS_LIMIT=3

# Ofcom Connected Nations API (for Broadband and Mobile coverage)
OFCOM_BROADBAND_API_KEY_PRIMARY=your-ofcom-broadband-primary-key
OFCOM_BROADBAND_API_KEY_SECONDARY=your-ofcom-broadband-secondary-key
OFCOM_MOBILE_API_KEY_PRIMARY=your-ofcom-mobile-primary-key
OFCOM_MOBILE_API_KEY_SECONDARY=your-ofcom-mobile-secondary-key

# Email Configuration (for email verification)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Logging Configuration
PROPERTY_LOG_LEVEL=INFO
HOMELY_CORE_LOG_LEVEL=INFO
